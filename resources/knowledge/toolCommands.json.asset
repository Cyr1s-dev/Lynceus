managers on an actual Linux host."},"category":{"zh":"Linux 全命令索引","en":"Linux Full Command Index"},"commands":[{"name":{"zh":"枚举当前 shell 全部命令","en":"List all commands available in the current shell"},"command":"compgen -c | sort -u","description":{"zh":"列出当前 shell 能补全到的全部命令名。","en":"List every command name completable by the current shell."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"枚举 PATH 可执行文件","en":"Enumerate executables on PATH"},"command":"find ${PATH//:/ } -maxdepth 1 -type f -perm -111 2>/dev/null | xargs -r -n1 basename | sort -u","description":{"zh":"从 PATH 目录枚举可执行文件。","en":"Enumerate executable files from PATH directories."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"枚举基础二进制目录","en":"Enumerate standard binary directories"},"command":"ls -1 /bin /usr/bin /sbin /usr/sbin /usr/local/bin /usr/local/sbin 2>/dev/null | sort -u","description":{"zh":"列出常见二进制目录里的命令。","en":"List commands in common binary directories."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"枚举 shell builtins","en":"Enumerate shell built-ins"},"command":"enable -a | sort","description":{"zh":"列出 Bash 内置命令。","en":"List Bash builtins. Record the filter expression, input source, and selected output fields so the text-processing result is reproducible."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"搜索 man 数据库","en":"Search the man-page database"},"command":"man -k .","description":{"zh":"列出 man 数据库中可搜索的手册条目。","en":"List searchable entries in the man database."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"查询命令来源","en":"Identify command origins"},"command":"type -a command_name","description":{"zh":"查看命令是内置、函数、别名还是可执行文件。","en":"Show whether a command is a builtin, function, alias, or executable."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"查询命令路径","en":"Resolve command paths"},"command":"command -V command_name","description":{"zh":"查看 shell 如何解析指定命令。","en":"Show how the shell resolves a command."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"Debian 包命令枚举","en":"Enumerate commands from Debian packages"},"command":"dpkg-query -L package_name | grep -E \"/s?bin/\"","description":{"zh":"查看 Debian 包安装了哪些命令。","en":"Show commands installed by a Debian package."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"RPM 包命令枚举","en":"Enumerate commands from RPM packages"},"command":"rpm -ql package_name | grep -E \"/s?bin/\"","description":{"zh":"查看 RPM 包安装了哪些命令。","en":"Show commands installed by an RPM package."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":"Busy Box 命令枚举","en":"Enumerate Busy Box applets"},"command":"busybox --list","description":{"zh":"列出 BusyBox 提供的 applets。","en":"List applets provided by Busy Box."},"syntaxBreakdown":[],"examples":[],"platform":"linux"}],"installation":{"zh":"在目标 Linux 实验机上运行；不同发行版和安装包会产生不同结果。","en":"Run on the target Linux lab host; results vary by distribution and installed packages."},"references":["https://man7.org/linux/man-pages/","https://www.gnu.org/software/coreutils/manual/"]},{"id":"linux-shell-builtins-index","name":{"zh":"Linux Shell Builtins 索引","en":"Linux Shell Builtins Index"},"description":{"zh":"Bash/POSIX shell 内置命令帮助索引。","en":"Help index for Bash/POSIX shell builtins."},"category":{"zh":"Linux 全命令索引","en":"Linux Full Command Index"},"commands":[{"name":{"zh":": 手册","en":": manual"},"command":"help :","description":{"zh":"Linux 命令索引项。该条目只打开 : 的 shell help 或 man 手册，不直接执行原命令。","en":"Linux command index entry. This opens shell help or the man page for : instead of executing the command."},"syntaxBreakdown":[],"examples":[],"platform":"linux"},{"name":{"zh":". 手册","en":". manual"},"command":"help .","description":{"zh":"Linux 命令索引项。该条目只打开 . 的 shell help 或 man 手册，不直接执行原命令。","en":"Linux command index entry. This opens shell help or the man page for . instead of executing the command."},"syntaxBr